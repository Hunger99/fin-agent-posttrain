# External paths of one machine. Copy to local.env (not tracked) and set each value; scripts/paths.sh reads local.env
# and stops when it is missing. POSIX VAR=value lines. The export line passes them to child processes: the Python
# modules read the FP_* variables from the environment, so before running one directly, `. environment_installation/local.env`.
# English-stage data, mixtures, harness databases and tasks
FP_DATA_EN="/home/<user>/datasets/fin-posttrain-en"
# Chinese-stage data (history)
FP_DATA_ZH="/home/<user>/datasets/fin-posttrain"
# agent SFT data, GRPO parquet, market_v1, harness_v2, judge_cal
FP_DATA_D2="/mnt/<data disk>/<user>/datasets/fin-posttrain-en"
# SFT checkpoints and rl/
FP_RUNS="/mnt/<data disk>/<user>/runs/fin-posttrain"
# Qwen3-4B-Base, Qwen3-14B, the Nemotron encoder, gpt-oss-120b
FP_MODELS_D1="/mnt/<model disk 1>/<user>/models"
# Qwen3.5-4B-Base, Qwen3.5-4B, Qwen3.8-27B
FP_MODELS_D2="/mnt/<model disk 2>/<user>/models"
# verl's HF, Ray spill and vLLM caches
FP_CACHE="/mnt/<data disk>/<user>/cache/verl"
# the Python environments (environment_installation/README.md)
FP_VENVS="/home/<user>/venvs"
# the market environment's sandbox interpreter
MARKET_SANDBOX_PYTHON="/home/<user>/venvs/mkt/bin/python"
# the GPU-claim tool's gpu_claim.py, and its test file (only for src/05_review/tests/rl_chain/)
GPU_CLAIM_PY="<path to gpu_claim.py>"
GPU_CLAIM_TESTS="<path to test_gpu_claim.py>"
# Hugging Face datasets cache of the SFT chains (default $HOME/.cache/huggingface/datasets when unset)
FP_HF_DATASETS_CACHE="/mnt/<data disk>/<user>/cache/hf_datasets"
# local-disk directory for Ray's temp dir and the Triton and Inductor caches of the RL launchers (default /tmp when unset)
FP_TMP="/tmp/<user>"
# Repository root, used only by the SFT yaml files under configs/03_model-training/sft/ (render them with envsubst).
FP_REPO="/path/to/fin-agent-posttrain"
export FP_REPO FP_DATA_EN FP_DATA_ZH FP_DATA_D2 FP_RUNS FP_MODELS_D1 FP_MODELS_D2 FP_CACHE FP_VENVS MARKET_SANDBOX_PYTHON GPU_CLAIM_PY GPU_CLAIM_TESTS \
  FP_HF_DATASETS_CACHE FP_TMP
